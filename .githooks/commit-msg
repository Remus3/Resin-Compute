#!/bin/sh
# ResinCompute commit-msg hook.
#
# Install per-clone with:
#   python scripts/install_hooks.py        (sets core.hooksPath for you)
# or directly:
#   git config core.hooksPath .githooks
#
# THREE jobs, and all three must stay in THIS file. Sibling-C kept two of
# them in two different files - the trailer strip only in the untracked
# `.git/hooks/commit-msg`, the subject validation only in the tracked one - so
# whichever file `core.hooksPath` resolved to, one of the two silently did not
# run. Do not split them again.
#
# THE ORDER IS LOAD-BEARING, not stylistic. Each step must see the message the
# previous step produced.

set -e

ROOT="$(git rev-parse --show-toplevel)"

# Interpreter selection is SHARED with pre-commit and pre-push. It used to be a
# private `command -v` copy in each of the three, which is a name lookup and not
# a capability test - see scripts/hook_python.sh for the measurement.
#
# No module is named here: both scripts below are stdlib-only, so any
# interpreter that RUNS does the job. The literal `python` stays as the last
# resort so the hook ERRORS rather than passing a message it never scanned -
# this gate is fail-CLOSED.
. "$ROOT/scripts/hook_python.sh"
PY="$(resin_pick_python)" || PY=python

# 1. Operator policy: never emit an AGENT trailer. TWO forms, not one.
#
# STRIP them rather than REJECT them. A session that adds one out of habit still
# commits cleanly, and the trailer simply is not in the message that lands.
# This is why its absence reads as an authoring omission rather than as a
# rejection - do not file that as a defect, and do not audit for it with a bare
# `grep -ci 'Co-Authored-By'`, which also matches prose ABOUT the trailer.
# Anchor the pattern and read the message TAIL.
#
# `Claude-Session:` WAS MISSING HERE UNTIL 2026-09-06, and the gap was not
# theoretical: a history sweep that day found BOTH forms on two commits - the
# root commit and one made later from the same hookless clone. The hook stripped
# the first and passed the second straight through. A policy enforced on one of
# its two forms is a policy that reads as enforced and is not. Any new trailer
# form goes in this list, and `tests/test_commit_trailers.py` fails if a message
# carrying either one survives this hook.
#
# Runs FIRST so steps 2 and 3 both see the final message.
# `|| true` because grep exits 1 when it filters away every line.
tmp="$1.rcfilt"
grep -v -i -e '^Co-Authored-By: Claude' -e '^Claude-Session:' "$1" > "$tmp" || true
mv "$tmp" "$1"

# 2. Banned glyphs in the MESSAGE.
#
# This half CANNOT live in pre-commit. Git's order is
#   pre-commit -> prepare the message -> commit-msg
# so `.git/COMMIT_EDITMSG` DOES NOT EXIST YET when pre-commit runs and there is
# nothing to scan. Splitting the gate across the two hooks is required, not
# stylistic.
#
# The failure mode is silent, which is why it survived in Sibling-C: with
# the gate invoked only from pre-commit, the staged-content and ruff halves
# still fired - so the gate LOOKED healthy - while a U+2014 em-dash in a commit
# SUBJECT committed clean.
"$PY" "$ROOT/tools/precommit_gate.py" --message-file "$1" || exit 1

# 3. Validate the subject line against Conventional Commits. Runs LAST so it
# judges the message that will actually be committed.
"$PY" "$ROOT/scripts/precommit_msg_check.py" "$1" || exit 1
